# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
APP_NAME=amd_play
MONGO_URI=mongodb://127.0.0.1:41111/amd_play
DB_STRATEGY=A

# Redis Configuration (Optional / Fallback)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Authentication Secrets
JWT_SECRET=super_secret_sports_academy_jwt_key_2026_dev_only!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_sports_academy_jwt_refresh_key_2026_dev!
JWT_REFRESH_EXPIRES_IN=30d

# MQTT Configuration
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sports_academy_backend

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Logging
LOG_LEVEL=debug
